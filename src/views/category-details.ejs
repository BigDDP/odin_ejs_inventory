<%- include("partials/head") %>

<html>
    <body class="bg-gray-100 min-h-screen">
        <div class="max-w-md mx-auto pt-16 pb-6 flex flex-col gap-4">
            <a href="/categories" class="self-end bg-blue-600 text-white font-medium rounded-lg px-4 py-2 hover:bg-blue-700">Categories</a>
            <form method="POST" action="/categories/<%= category.id %>/update" class="flex gap-2">
                <input type="text" name="title" id="title" value="<%= category.text %>" data-original="<%= category.text %>" required maxlength="255"
                       pattern="[A-Za-z]+" title="Letters only (A-Z, a-z)"
                       class="flex-1 border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                <button type="submit" id="edit" disabled
                        class="bg-blue-600 text-white font-medium rounded-lg px-4 py-2 hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">Edit</button>
                <button type="submit" formaction="/categories/<%= category.id %>/delete" formnovalidate
                        onclick="return confirm('Delete this category? Its items will be kept but left without a category.')"
                        class="bg-red-600 text-white font-medium rounded-lg px-4 py-2 hover:bg-red-700">Delete</button>
            </form>
        </div>
        <div class="max-w-md mx-auto flex flex-col gap-3">
            <% if (items.length === 0) { %>
                <p class="text-gray-500">No items in this category yet.</p>
            <% } %>
            <% items.forEach((item) => { %>
                <div class="bg-white rounded-xl shadow p-4 flex flex-col gap-1">
                    <h3 class="font-semibold text-gray-900"><%= item.text %></h3>
                    <p class="text-gray-500"><%= item.description %></p>
                    <div class="flex items-center justify-between">
                        <a href="/items/<%= item.id %>" class="text-sm text-blue-600 hover:underline">Edit</a>
                        <p class="text-xs text-gray-400">Supply: <%= item.supply %></p>
                        <p class="text-xs text-gray-400">Cost: $<%= item.cost %></p>
                    </div>
                </div>
            <% }) %>
        </div>

        <script>
            const input = document.getElementById("title")
            const button = document.getElementById("edit")
            input.addEventListener("input", () => {
                button.disabled = input.value.trim() === input.dataset.original
            })
        </script>
        <% if (error) { %>
            <script>alert("<%= error %>")</script>
        <% } %>
    </body>
</html>
