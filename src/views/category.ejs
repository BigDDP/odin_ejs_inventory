<%- include("partials/head") %>

<html>
    <body class="bg-gray-100 min-h-screen">
        <div class="max-w-md mx-auto pt-16 pb-6 flex items-center justify-between">
            <h1 class="text-2xl font-semibold text-gray-900">Categories</h1>
            <div class="flex gap-2">
                <button type="button" id="new-category-toggle" class="bg-blue-600 text-white font-medium rounded-lg px-4 py-2 hover:bg-blue-700">New Category</button>
                <a href="/" class="bg-blue-600 text-white font-medium rounded-lg px-4 py-2 hover:bg-blue-700">Home</a>
            </div>
        </div>
        <form method="POST" action="/categories/create" id="new-category-form" class="<%= error ? '' : 'hidden' %> max-w-md mx-auto pb-6 flex gap-2">
            <input type="text" name="title" placeholder="Category name" required maxlength="255"
                   pattern="[A-Za-z]+" title="Letters only (A-Z, a-z)"
                   class="flex-1 border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
            <button type="submit" class="bg-blue-600 text-white font-medium rounded-lg px-4 py-2 hover:bg-blue-700">Submit</button>
        </form>
        <div class="max-w-md mx-auto flex flex-col gap-3">
            <% categories.forEach((category) => { %>
                <a href="/categories/<%= category.id %>"><div class="bg-white rounded-xl shadow p-4 flex flex-col gap-1">
                    <h3 class="font-semibold text-gray-900"><%= category.text %></h3>
                </div>
                </a>
            <% }) %>
        </div>

        <script>
            document.getElementById("new-category-toggle").addEventListener("click", () => {
                const form = document.getElementById("new-category-form")
                form.classList.toggle("hidden")
                if (!form.classList.contains("hidden")) form.querySelector("input").focus()
            })
        </script>
        <% if (error) { %>
            <script>alert("<%= error %>")</script>
        <% } %>
    </body>
</html>
